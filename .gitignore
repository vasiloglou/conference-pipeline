# Helper scripts (session filtering)
scripts/helpers/

# macOS metadata
.DS_Store
**/.DS_Store

# First Principles strategy documents (private)
first_principles/

# Conference workspace artifact lanes are governed by each
# conferences/<slug>/.gitignore file generated from storage/storage_manifest.json.

# High-volume regenerated local outputs stay out of git; receipts and curated
# proof artifacts remain explicitly addable.
storage/provider-calls/**
conferences/*/storage/transcription-ocr/media/**
conferences/*/storage/transcription-ocr/text-extraction/**
conferences/*/storage/transcription-ocr/ocr-model-benchmark/**
conferences/*/storage/experiments/**
conferences/*/storage/extractions/**
conferences/*/storage/research/**
conferences/*/storage/vector-store/**
conferences/*/storage/workflow-runs/*presentation-validation*/**
conferences/*/storage/workflow-runs/v15-pv-*/**

# Remote-backup payload staging. Keep backup receipts/verification evidence in
# git; only ignore copied payloads that are meant to live in backup storage.
conferences/*/storage/**/backup-payloads/**
conferences/*/storage/**/backup-staging/**
conferences/*/storage/**/backup-store/**

# Generic timestamped workflow scratch runs; commit named proof receipts explicitly
conferences/*/storage/workflow-runs/run-*/

# Analysis attachments
conferences/*/analysis/*.pdf

# Regenerable cache binaries
*.pkl
*.sqlite3
*.bin

# Regenerable conference vector stores
conferences/*/vector_store/

# Binary/media files
*.pptx
*.pdf
*.mp3
*.mp4
*.m4a
*.wav
*.tmp

# Historical bulk not meant for the live repo
past-conferences/

# Regenerable intermediate canonical markdown (adapter build artifact --
# regenerate via scripts/presentations/adapt_ai4physics_slides_to_revealjs.py)
cross-conference-talks/ai4physics2026/decks/ai4physics-talk/_canonical_slides.md

# Local tool caches (tiktoken files pre-fetched for GPT-Researcher; never downloaded at run time)
/.cache/

# Codex runtime copy of the repo skills (word-swapped from .claude/skills, which is canonical).
/.agents/

# Review rounds: the diff and the reviewer log carry diff text with private markers
# (the removed lines of a scrub, generic fixtures); they stay in the checkout only.
.planning/milestones/*/notes/reviews/*/diff.patch
.planning/milestones/*/notes/reviews/*/review.log
