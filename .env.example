# NeurIPS Pipeline Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Conference Year
# ==========================================
# Set the conference year. Note: NeurIPS 2025 won't be available until Dec 2025.
# Use 2024 for testing with existing conference data.
NEURIPS_YEAR=2024

# ==========================================
# NeurIPS Credentials (required for discovery)
# ==========================================
NEURIPS_EMAIL=your-email@example.com
NEURIPS_PASSWORD=your-password

# ==========================================
# API Keys
# ==========================================
# OpenAI API key (for transcription and LLM OCR)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic API key (for LLM OCR alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google/Gemini API key (for Gemini OCR, presenter scripts, and TTS/video)
GOOGLE_API_KEY=your-google-api-key
# Optional alias used by some provider checks; keep values in .env only.
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# Storage Configuration
# ==========================================
# Storage root is auto-generated based on NEURIPS_YEAR if not set
# STORAGE_ROOT=./data/neurips_2024

# ==========================================
# Pipeline Settings
# ==========================================
# Maximum concurrent HTTP requests
MAX_CONCURRENT_REQUESTS=4

# Delay between requests (seconds)
REQUEST_DELAY_SECONDS=0.5

# Maximum retries for failed requests
MAX_RETRIES=3

# ==========================================
# Transcription Settings
# ==========================================
# Provider: openai, anthropic, local, external
TRANSCRIPTION_PROVIDER=openai

# OpenAI model for transcription (diarized by default for talks/Q&A)
OPENAI_MODEL=gpt-4o-transcribe-diarize

# Anthropic model for lower-latency bulk LLM tasks
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ==========================================
# OCR Settings
# ==========================================
# Tesseract language(s)
OCR_LANGUAGE=eng

# Use LLM for OCR instead of/in addition to Tesseract
USE_LLM_OCR=false

# ==========================================
# Browser Automation
# ==========================================
# Use Playwright for JS-heavy pages
USE_PLAYWRIGHT=true

# Run browser in headless mode
# Set to false if login fails (some sites block headless browsers for bot detection)
HEADLESS=true

# Browser timeout in milliseconds
BROWSER_TIMEOUT=30000

# ==========================================
# Audio Settings
# ==========================================
# Audio format for downloads
AUDIO_FORMAT=mp3

# Sample rate for audio processing
AUDIO_SAMPLE_RATE=16000

# Maximum chunk size for transcription API (bytes)
AUDIO_CHUNK_MAX_BYTES=24117248

# ==========================================
# Logging
# ==========================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional log file path
# LOG_FILE=./logs/pipeline.log

# Use structured logging with structlog (requires: pip install structlog)
USE_STRUCTURED_LOGGING=true

# ==========================================
# Reference Normalization
# ==========================================
# Use LLM to normalize messy reference text
USE_LLM_REFERENCE_NORMALIZATION=false

# ==========================================
# LLM Video Detection (optional)
# ==========================================
# Use an LLM to quickly decide if a page likely contains a SlidesLive embed and
# optionally pick the best candidate link to follow. This can reduce waiting on
# pages that never load an embed.
USE_LLM_VIDEO_DETECTION=false
VIDEO_DETECTION_PROVIDER=openai
VIDEO_DETECTION_MODEL=gpt-5-mini

# ==========================================
# Paper Matching (v1.91)
# ==========================================
# Frontier model used to extract keypoints from artifact GPT-Researcher findings.
PAPER_MATCHING_KEYPOINT_PROVIDER=openai
PAPER_MATCHING_KEYPOINT_MODEL=gpt-5.5

# Store names used by the dual-vector-store paper matching flow.
PAPER_MATCHING_ARTIFACT_STORE=artifacts
PAPER_MATCHING_PAPER_STORE=papers
PAPER_MATCHING_OUTPUT_TOP_N=20

# ==========================================
# Rate Limiting (per-domain limits)
# ==========================================
# Maximum concurrent requests per domain
RATE_LIMIT_NEURIPS=3
RATE_LIMIT_SLIDESLIVE=3
RATE_LIMIT_ARXIV=3
RATE_LIMIT_CROSSREF=5
RATE_LIMIT_SEMANTIC_SCHOLAR=5
RATE_LIMIT_DEFAULT=4

# ==========================================
# Google Drive Sync (optional)
# ==========================================
# Conference-aware sync profiles resolve their default destinations from these
# env vars. Keep the values local to your machine; do not commit real mount
# paths into versioned docs.
GDRIVE_PUBLIC_PATH=/path/to/GoogleDrive/My Drive/NeurIPS 2025
GDRIVE_BACKUP_PATH=/path/to/GoogleDrive/My Drive/NeurIPS 2025-raw

# Deprecated: legacy single-target sync variable kept only for compatibility
# during the Phase 2 migration. Prefer GDRIVE_PUBLIC_PATH / GDRIVE_BACKUP_PATH.
# GDRIVE_REMOTE_PATH=/path/to/legacy/single-target
